Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# This release is static. Never execute a leftover PHP starter page.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule \.(?:php[0-9]?|phtml|phar)$ - [F,L,NC]
RewriteCond %{THE_REQUEST} \s/+_site(?:[/\s?]) [NC]
RewriteRule ^ - [F,L]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^selenoa\.com$ [NC]
RewriteRule ^ https://selenoa.com%{REQUEST_URI} [R=301,L]
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=2592000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always unset X-Powered-By
# The release packager appends a CSP with hashes of the rendered inline scripts.
</IfModule>

<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-WD79qyAvx56Nz8bGyeF7SrSLSWlydEYu/UOqkEuioSc=' 'sha256-oWX4lYmPdFkZtCDiIDF/MLgaz56LY9hphuC/4dj7u+g=' 'sha256-gUeurErOecsMOVMm70va9sAbqYpnozzPOxnEWqVLBc4=' 'sha256-zO0vukuLehb+N5DP7LgixLZdCoklAtArG1COnJXazbk=' 'sha256-+CGox/Bhhpb1zZhLXiYKwQkNU3N/pumZDjJpbdhq4fY=' 'sha256-f0j5apPslhS21pa0oIfg/Jaoa0F8mtzTY8lGiyE4HNE=' 'sha256-QY+DfdkvXXAsyNaZiF5WNaQpjWCak8kFPIfPfAsf3yA=' 'sha256-ZOEsK3DkURbowq1VQSa3vKXeXQiyHlYsxUTPyf/JJSI=' 'sha256-DKcpDIbFVJTgMSS0q1f26SXiXsR4Wl46Zai4TXTd0TU=' 'sha256-etBgIjUXdmK3ONrllACNfoY4N1fSlvcd3IumdWJ7XyU=' 'sha256-5ZuLf4mbFzXE5hBPFlhFockzoMM/3t/HstijmNnX/YY=' 'sha256-69dgfEKORnb1v5pB5yR54K5GFFz0RHmYfdyd4DiumRI=' 'sha256-dokSv5FmBWDFM5yyBq3kh2omnAX8PfqJnP77pzwqlqM=' 'sha256-+FS36wZyITa/RH02RVXIVTm8IN5iw0KvRqdB2xfH8SQ=' 'sha256-3IN4TtBNti3xHAO4ok5OlTAhaQBLmm8pRxk05aR3gyE=' 'sha256-KD9EiE1HJIZ5VODWYUB0Za6sKcsKNcjNGDikPtgak54=' 'sha256-JMWEsMNmEWSgj6fznEXCgWrCoUUjkaM+lKki21r64t8=' 'sha256-pliVNkF5OaQ9tCRo0ja42e3yaG5R+Mbqt6IRlq0gjgA=' 'sha256-lSY8hrQOClw7iCMeNc9khMJ9FC4JTugA2JrxMm0Wjdo=' 'sha256-dMgIDxZz2PNJ2Ocd0fxA992tb+sznJUwHhIZmAPuBX4=' 'sha256-mM3F5t2hOHwzmofbXtYjfzk8xbrjtMoe9BP5lX1MUkE=' 'sha256-d5z7kZrRq9J2aOd+zIb8ac7em5VPZ5X8CZkBR2GOhag=' 'sha256-AWSCNxL5WUePomVmz+Z5Bh3VU0lm9x/WgYifjBaOXyo=' 'sha256-e3qY7BTjeHmOBKt85f2r7er5GPeuFkrpUaa5HcrFFfI=' 'sha256-snn+b/pq8CPowK0aMgC76ktmRxBtbIVJy8/BPYHUVAo=' 'sha256-RII+7nZFDWLy9JeazCF/nGOWnn9q8Fi6eRaBEjpiovk=' 'sha256-ZtzUJJ1uMrMAtPllJouAjcbB9SYtI87xy06myFlAvnc=' 'sha256-F4ZiPurDpRBaN8yVEl3v6cg/2dn1a0I+IsfFnPFCe7E=' 'sha256-nvcPpDxeDlVcAitFsnamd8/AyQDZKNx9KNdlE22u7Lg=' 'sha256-R5/Hmu+g1WPeg3YJvHFTiQKXiEoW15NKkSSSm6xEEKo=' 'sha256-Yp5G/K33hBhk0HWyywYl7XNzNpXiUUImV+aEYenvl4M=' 'sha256-DFJ+5Fq2TOb7RFb31FM5r3emc2tk5gGdpcZ7Hbiq0n8=' 'sha256-02w81AUS5cDegoPHcIv/Kjk5xg0ml9