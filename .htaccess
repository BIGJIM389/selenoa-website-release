Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# This release is static. Never execute a leftover PHP starter page.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule \.(?:php[0-9]?|phtml|phar)$ - [F,L,NC]
RewriteCond %{THE_REQUEST} \s/+_site(?:[/\s?]) [NC]
RewriteRule ^ - [F,L]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^selenoa\.com$ [NC]
RewriteRule ^ https://selenoa.com%{REQUEST_URI} [R=301,L]
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=2592000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always unset X-Powered-By
# The release packager appends a CSP with hashes of the rendered inline scripts.
</IfModule>

<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-WD79qyAvx56Nz8bGyeF7SrSLSWlydEYu/UOqkEuioSc=' 'sha256-t3GcVlQx2okFfc2fsTaZnSzW4QV8PzjVgvRHN8pxe7o=' 'sha256-gUeurErOecsMOVMm70va9sAbqYpnozzPOxnEWqVLBc4=' 'sha256-zO0vukuLehb+N5DP7LgixLZdCoklAtArG1COnJXazbk=' 'sha256-+CGox/Bhhpb1zZhLXiYKwQkNU3N/pumZDjJpbdhq4fY=' 'sha256-f0j5apPslhS21pa0oIfg/Jaoa0F8mtzTY8lGiyE4HNE=' 'sha256-QY+DfdkvXXAsyNaZiF5WNaQpjWCak8kFPIfPfAsf3yA=' 'sha256-ZOEsK3DkURbowq1VQSa3vKXeXQiyHlYsxUTPyf/JJSI=' 'sha256-DKcpDIbFVJTgMSS0q1f26SXiXsR4Wl46Zai4TXTd0TU=' 'sha256-etBgIjUXdmK3ONrllACNfoY4N1fSlvcd3IumdWJ7XyU=' 'sha256-5ZuLf4mbFzXE5hBPFlhFockzoMM/3t/HstijmNnX/YY=' 'sha256-xGuL8/M31sBAVFNyIm5Tyb/oB8gc6/RSbequb/2ZNBE=' 'sha256-zikH5SeQEpJ7lC20Ugy/hYTiCYmlybTtAyf42metRuY=' 'sha256-+FS36wZyITa/RH02RVXIVTm8IN5iw0KvRqdB2xfH8SQ=' 'sha256-3IN4TtBNti3xHAO4ok5OlTAhaQBLmm8pRxk05aR3gyE=' 'sha256-KD9EiE1HJIZ5VODWYUB0Za6sKcsKNcjNGDikPtgak54=' 'sha256-/GCNpggvNIyeyRCcKaPfo3MyJhWiazrs3K8mmB47Kk4=' 'sha256-lSY8hrQOClw7iCMeNc9khMJ9FC4JTugA2JrxMm0Wjdo=' 'sha256-oH2cnCHnC7K6AdKXXiRhCrW9/sUmd+rbcxf0MHgA0mE=' 'sha256-FEUlvcgqPFHkQAvViWEL7E9bpHQiQpONpYPbg10SE2E=' 'sha256-teI+tFgxDr5ufUOwxx28oJ0rtno0cHMd1dkV65jHIZk=' 'sha256-fOSvQLj77bBBJE2PmvLqdM7nasRMdE2+pSUwteJSWUo=' 'sha256-El8S6qNNN8ZU/C3k1LsSATBppuxKk3o4i3yLiC6JUcY=' 'sha256-metWpOLtp6fuUgGhRd+DY/oc66ylfJQVa1zO2oCCgKg=' 'sha256-UFxkM7EVPiDuk16ebxaHgrSuH+RHyC4ptE4yzDYBMPk=' 'sha256-NPzrpZJIZM1thdOIYApAwHYRZp8Xs5a/oinfJkNmtBw=' 'sha256-g0HPGDWjgdAmxB/AgL67N6GaaYkS1hQuHTdqi+Y9ir8=' 'sha256-Ktic0ga2Uqgje+6AjqB2KyMgzhHVlYJNzpcYso6Us6E=' 'sha256-F4ZiPurDpRBaN8yVEl3v6cg/2dn1a0I+IsfFnPFCe7E=' 'sha256-X/WDZ+tZTVX4umGoLcwT19mehBvkm6eGdYD3QRo219k=' 'sha256-ce558+t4lD7ce0ePAyEY+RWJH8XV/ENgnzqIDNysLzY=' 'sha256-ceNu3gceTBis4fYe7p7mtvr/+53j+wY2G+/zePDpoV8=' 'sha256-DFJ+5Fq2TOb7RFb31FM5r3emc2tk5g